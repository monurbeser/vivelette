[gd_scene format=3]

[node name="Main" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(1, 0.94, 0.97, 1)

[node name="CenterContainer" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="TitleStack" type="VBoxContainer" parent="CenterContainer"]
layout_mode = 2
theme_override_constants/separation = 8
alignment = 1

[node name="Title" type="Label" parent="CenterContainer/TitleStack"]
layout_mode = 2
theme_override_colors/font_color = Color(0.86, 0.12, 0.5, 1)
theme_override_font_sizes/font_size = 86
text = "Vivellette"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="CenterContainer/TitleStack"]
layout_mode = 2
theme_override_colors/font_color = Color(0.25, 0.2, 0.35, 1)
theme_override_font_sizes/font_size = 32
text = "Dress Up"
horizontal_alignment = 1
